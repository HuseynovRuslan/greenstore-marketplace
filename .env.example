# Copy to .env.local for local overrides. Never commit real secrets — this frontend needs none.

# Public origin used for canonical URLs, Open Graph, sitemap.xml and robots.txt (no trailing slash).
# On Vercel it falls back to the project's production / deployment URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "Demo versiya" banner. The site runs on sample data and a simulated login — keep it on until a real API exists.
NEXT_PUBLIC_DEMO_MODE=true

# Search-engine indexing. Indexing is only enabled when SEO_INDEXABLE=true AND DATA_SOURCE is not "mock".
# Leave both as they are for staging: the sample listings must never be indexed as real inventory.
SEO_INDEXABLE=false
DATA_SOURCE=mock
