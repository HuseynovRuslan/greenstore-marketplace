# Copy to .env.local for local overrides. Never commit real secrets: the mock mode needs none, the API mode one key.

# Public origin used for canonical URLs, Open Graph, sitemap.xml and robots.txt (no trailing slash).
# On Vercel it falls back to the project's production / deployment URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "Demo versiya" banner. The site runs on sample data and a simulated login — keep it on until a real API exists.
NEXT_PUBLIC_DEMO_MODE=true

# Search-engine indexing. Indexing is only enabled when SEO_INDEXABLE=true AND DATA_SOURCE is not "mock".
# Leave both as they are for staging: the sample listings must never be indexed as real inventory.
SEO_INDEXABLE=false
DATA_SOURCE=mock

# DATA_SOURCE=api only (server-only, never NEXT_PUBLIC_): the GreenStore Web API (backend/README.md) and the shared
# key the API checks before it believes the visitor's IP (X-Client-IP). The value below is the API's dev default
# (backend/src/GreenStore.Api/appsettings.Development.json); real keys live in the hosting's secrets only.
# API_BASE_URL=http://localhost:5080
# API_INTERNAL_KEY=dev-internal-key
# Sign-ins keep the API's session token in the httpOnly gs_session cookie (Secure when NODE_ENV=production, so serve the
# site over https there); nothing else to configure. Without API_INTERNAL_KEY the API counts every visitor as the
# Next.js server's IP, and its per-IP SMS and sign-in limits then apply to the whole site.
# The visitor's IP is read only from what the hosting's proxy writes (README.md «Visitor IP behind the hosting's
# proxy»): by default the last X-Forwarded-For entry (Vercel, nginx with $proxy_add_x_forwarded_for). Never expose
# `next start` to the internet without a proxy in front: a visitor could then choose the IP the limits count.
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUSTED_PROXY_HOPS=1
# The listing cycle (backend-contract.md 3.2, 3.6). Browsers upload the posting's photos straight to the API and show
# the uploaded photos from its media address, so the CSP (connect-src, img-src) and next/image name both; set them for
# the build and the server alike. Unset, they follow API_BASE_URL (local dev: http://localhost:5080 and …/media).
# API_PUBLIC_URL=https://api.example.az
# MEDIA_BASE_URL=https://cdn.example.az/media
# The API's change notices (POST /api/revalidate) carry this shared secret: the same value as the API's
# Revalidation__Secret. The value below is the API's dev default; without it the route refuses every notice and pages
# refresh within a minute on their own.
# REVALIDATE_SECRET=dev-revalidate-secret

# Footer social profiles (https only; an unset or invalid value hides that icon). Read at build time.
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/<profile>
# NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/<page>
# NEXT_PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@<profile>
# NEXT_PUBLIC_SOCIAL_WHATSAPP_URL=https://wa.me/994XXXXXXXXX
