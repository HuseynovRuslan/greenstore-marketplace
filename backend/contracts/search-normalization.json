    { "input": "I", "expected": "i", "note": "dotless capital I is ı in Azerbaijani, which then becomes i" },
    { "input": "ı", "expected": "i" },
    { "input": "İTALYAN IŞIQ", "expected": "italyan isiq" },
    { "input": "İynəyarpaqlı ağaclar", "expected": "iyneyarpaqli agaclar" },
