<Project>
  <!-- Central package management: every package version of the backend lives here. -->
  <!-- net10.0 only: NuGet's 11.x packages target .NET 11 and do not work here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- API -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Phase 2: PasswordHasher only. Part of the ASP.NET Core shared framework, so the API uses that copy and has no
         PackageReference to it (NU1510); pinned here should a non-web project ever need it. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.15" />
    <!-- Phase 3: photo processing (libvips; NetVips.Native carries the native library for every platform) and
         S3-compatible storage (Cloudflare R2, Hetzner, AWS). -->
    <PackageVersion Include="NetVips" Version="3.2.0" />
    <PackageVersion Include="NetVips.Native" Version="8.18.7" />
    <PackageVersion Include="AWSSDK.S3" Version="4.1.2" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
