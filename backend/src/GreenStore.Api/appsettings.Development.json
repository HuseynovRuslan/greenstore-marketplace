{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=greenstore;Username=greenstore;Password=greenstore_dev"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Internal": {
    "ApiKey": "dev-internal-key"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "Revalidation": {
    "Secret": "dev-revalidate-secret"
  },
  "Media": {
    "BaseUrl": "http://localhost:5080/media",
    "UploadOrigins": [
      "http://localhost:3000",
      "http://localhost:3100"
    ]
  },
  "Seed": {
    "Reference": true,
    "Demo": true,
    "DevAccounts": true
  },
  "Otp": {
    "HmacKey": "dev-only-otp-hmac-key",
    "ExposeDemoCode": true
  },
  "Payments": {
    "Fake": {
      "Secret": "dev-only-fake-payment-secret"
    }
  }
}
