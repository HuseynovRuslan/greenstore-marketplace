{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Internal": {
    "ApiKey": ""
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Revalidation": {
    "Secret": "",
    "TimeoutSeconds": 10
  },
  "Media": {
    "BaseUrl": "/media",
    "Storage": "local",
    "LocalPath": ".media",
    "UploadBaseUrl": "",
    "UploadOrigins": [],
    "UploadMinutes": 10,
    "MaxBytes": 10485760,
    "MinSide": 600,
    "MaxPixels": 50000000,
    "MaxUnattachedPerUser": 60,
    "S3": {
      "ServiceUrl": "",
      "Region": "auto",
      "Bucket": "",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true
    }
  },
  "Seed": {
    "Reference": true,
    "Demo": false,
    "DevAccounts": false
  },
  "Otp": {
    "HmacKey": "",
    "ExposeDemoCode": false,
    "CodeLength": 4,
    "LifetimeSeconds": 300,
    "ResendSeconds": 60,
    "MaxAttempts": 5,
    "VerifiedLifetimeSeconds": 1800,
    "PerPhoneHourly": 5,
    "PerPhoneDaily": 10,
    "PerIpHourly": 20,
    "PerIpDaily": 100,
    "GlobalDailyCap": 2000
  },
  "Sms": {
    "Provider": "log",
    "ApiUrl": "",
    "Login": "",
    "Password": "",
    "ApiKey": "",
    "Sender": "GreenStore",
    "TimeoutSeconds": 10
  },
  "Listings": {
    "MaxSubmissionsPerDay": 30,
    "MaxDraftsPerUser": 20,
    "MaxDraftBytes": 65536
  },
  "Jobs": {
    "Enabled": true,
    "FirstRunDelaySeconds": 10,
    "ExpireListingsSeconds": 600,
    "OutboxSeconds": 5
  },
  "Cleanup": {
    "Enabled": true,
    "FirstRunDelaySeconds": 60
  },
  "Auth": {
    "FailedLoginsPerIp": 30,
    "FailedLoginsWindowMinutes": 15
  },
  "RateLimiting": {
    "AnonymousWrites": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Views": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "PhoneReveals": {
      "PermitLimit": 30,
      "WindowSeconds": 600
    }
  }
}
